# 复制为 .env 后填写。.env 已在 .gitignore 中, 不会被提交。

# ---- 数据源(必填) ----
STOCK_ROOT=/path/to/stock
INDEX_ROOT=/path/to/index
TICK_ROOT=/path/to/tick

# ---- 运行 ----
PYTHON_BIN=python
N_WORKERS=48

# ---- 邮件(可选; 不填则只落地文件不发信) ----
# QQ邮箱: 设置 -> 账号 -> 开启"POP3/SMTP服务" -> 生成授权码
# SMTP_PASS 填授权码, 不是登录密码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=
