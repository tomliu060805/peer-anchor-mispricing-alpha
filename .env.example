# 复制为 .env 并按自有数据环境填写; 或直接 export
# 项目根(留空则自动由 src/paths.py 推导)
# PROJ_ROOT=/path/to/peer-anchor-mispricing-alpha

# --- 必需: 行情与逐笔数据源(按 docs/data_requirements.md 的表结构准备) ---
STOCK_ROOT=/path/to/stock_daily      # 日频OHLC/停牌/涨跌停/财务/行业/ST
INDEX_ROOT=/path/to/index            # 指数日频与1分钟
TICK_ROOT=/path/to/l2_tick           # L2逐笔成交(沪: 逐笔成交表; 深: 逐笔成交含撤单)

# --- 可选 ---
BARRA_ROOT=                          # 风格因子暴露(仅中性化验真使用, 留空则跳过该检验)
MONEYFLOW_ROOT=                      # 日频大单资金流(留空则由逐笔自建)
EXT_REGIME_ROOT=                     # 外部对照项目(少数诊断脚本, 可留空)
EXT_THEME_ROOT=                      # 外部主题库(资金流补算, 可留空)
